# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# SQLite for now (default). File will be created automatically.
DATABASE_URL=sqlite+aiosqlite:///albion_bot.db

# When ready to move to Postgres, install asyncpg and set:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/albion_bot

# Optional: restrict slash command sync to one guild while developing (faster sync).
# Leave blank to sync globally.
DEV_GUILD_ID=
